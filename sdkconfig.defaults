# Compiler
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_LTO_ENABLED=y
CONFIG_NEWLIB_NANO_FORMAT=y
# Stack canaries on functions with local arrays: a stack buffer overflow panics
# with a backtrace instead of silently corrupting the return address
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y

# Logging
# CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# MQTT - disable unused transports
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MQTT_TRANSPORT_SSL=n
CONFIG_MQTT_PROTOCOL_311=n
CONFIG_MQTT_PROTOCOL_5=y

# HTTP server - WebSocket support for the web UI's live Debug Log page (/ws/log)
CONFIG_HTTPD_WS_SUPPORT=y

# mDNS
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# WiFi - 802.11k/v so a mesh (e.g. eero) can steer the client between nodes
CONFIG_ESP_WIFI_11KV_SUPPORT=y

# Flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TLS certificate bundle — used by the GitHub firmware update (HTTPS release
# lookup + esp_https_ota). The full bundle covers github.com and the
# objects.githubusercontent.com host that release downloads redirect to.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Bootloader
# CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# Boot back into the previous firmware if a new OTA image resets before the app
# confirms it (see confirm_ota_image_when_stable in main.c). Lives in the
# bootloader, which OTA never replaces, so it needs a USB flash to take effect.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Stamped into the bootloader image so the app can tell which bootloader is in
# flash (shown on the home page). Bump it whenever a bootloader setting changes;
# 2 = rollback support (see BOOTLOADER_ROLLBACK_MIN_VERSION in config.h).
CONFIG_BOOTLOADER_PROJECT_VER=2